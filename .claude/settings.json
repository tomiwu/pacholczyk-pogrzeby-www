{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow:*)",
      "Bash(gh api:*)",
      "Bash(cat .env:*)",
      "Bash(cat .sandcastle/.env:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.sandcastle/.env)",
      "Read(./**/.env)",
      "Edit(./docs/PRD.md)",
      "Write(./docs/PRD.md)",
      "Edit(./.sandcastle/**)",
      "Write(./.sandcastle/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(cat /workspace/pacholczyk-www-secrets/**)",
      "Read(/workspace/pacholczyk-www-secrets/**)",
      "Read(./.secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
