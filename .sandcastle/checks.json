{
  "setup": "npm ci --no-audit --no-fund",
  "checks": [
    [
      "format",
      "npm run format:check"
    ],
    [
      "lint",
      "npm run lint"
    ],
    [
      "typecheck",
      "npm run typecheck"
    ],
    [
      "test",
      "npm test"
    ],
    [
      "build",
      "npm run build"
    ],
    [
      "schema",
      "npm run test:schema"
    ],
    [
      "e2e-a11y",
      "npm run test:e2e"
    ],
    [
      "lighthouse",
      "npm run lighthouse"
    ]
  ],
  "earlyHostCheck": ""
}
