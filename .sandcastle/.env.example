# Copy to .sandcastle/.env (mode 600). Never commit .sandcastle/.env.
# Fine-grained PAT for tomiwu/pacholczyk-pogrzeby-www only:
# Contents, Issues, Pull requests, Workflows, Administration (read/write).
GH_TOKEN=
# Claude Code (the loop agent). Reuse the existing hotel-loop token. Do not commit it.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
PROJECT=pacholczyk-pogrzeby-www
STATUS_FILE=/tmp/pacholczyk-www-loop.status.json
# Loop events webhook URL (routine "pacholczyk-www: loop events").
# Header: Authorization: Bearer <key>.
# The sender key is NOT in this file. It lives in the git-ignored file
# /workspace/pacholczyk-www-secrets/loop-webhook-key (mode 600).
# scripts/start-loop.sh reads that file and sets LOOP_WEBHOOK_KEY.
LOOP_WEBHOOK_URL=
