{
  "name": "pacholczyk-pogrzeby-www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build && tsx scripts/postbuild.ts",
    "test:schema": "tsx scripts/check-schema.ts out",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.10.1",
    "schema-dts": "2.1.0",
    "serve": "14.2.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
